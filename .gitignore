# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Python virtual environments
.venv/
venv/
env/

# Environment variables and local secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python packaging artifacts
build/
dist/
*.egg-info/

# Terraform local artifacts
**/.terraform/
*.tfstate
*.tfstate.*
tfplan
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json

# Allow reviewed example variable files
!*.example.tfvars
!*.example.tfvars.json

# Local tool and editor files
.DS_Store
.idea/
.vscode/

# Test and coverage output
.coverage
htmlcov/
coverage.xml

# Logs
*.log